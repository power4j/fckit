<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.power4j.fist4</groupId>
    <artifactId>fist-kit-reactor-build</artifactId>
    <version>1</version>
    <relativePath>.mvn/kit-reactor/pom.xml</relativePath>
  </parent>

  <groupId>com.power4j.fist4</groupId>
  <artifactId>fist-kit-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>${project.artifactId}</name>
  <url>https://github.com/power4j/fckit-v3</url>
  <description>Fist Cloud Dependencies</description>

  <licenses>
    <license>
      <name>GNU LESSER GENERAL PUBLIC LICENSE</name>
      <url>https://www.gnu.org/licenses/lgpl-3.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>ChenJun</name>
      <email>powe4j@outlook.com</email>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/power4j/fckit</url>
    <connection>scm:git:git://github.com/power4j/fckit-v3.git</connection>
    <developerConnection>scm:git:https://github.com/power4j/fckit-v3.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <skipTests>false</skipTests>
    <revision>4.0.0-rc1</revision>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.source>17</maven.compiler.source>

    <spring-boot.version>4.2.0</spring-boot.version>
    <spring-cloud.version>2026.0.0</spring-cloud.version>
    <!-- plugin -->
    <mapstruct.version>1.6.0</mapstruct.version>
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <spring-javaformat.plugin.version>0.0.47</spring-javaformat.plugin.version>
    <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
    <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    <jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <git-commit-id-plugin.version>10.0.0</git-commit-id-plugin.version>
    <maven-surefire-plugin.version>3.5.5</maven-surefire-plugin.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-dependency-plugin.version>3.10.0</maven-dependency-plugin.version>
    <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
    <!-- libs -->
    <commons-io.version>2.22.0</commons-io.version>
    <commons-collections4.version>4.5.0</commons-collections4.version>
    <coca-kit.version>0.4.1</coca-kit.version>
    <tile.version>1.8.3</tile.version>
    <guava.version>33.6.0-jre</guava.version>
    <redisson.version>4.3.1</redisson.version>
    <okhttp3.version>4.12.0</okhttp3.version>
    <ez-captcha.version>0.1.1</ez-captcha.version>
    <dict-mapper.version>0.1.3</dict-mapper.version>
    <friendly-id.version>1.1.0</friendly-id.version>
    <bcprov-18.version>1.84</bcprov-18.version>
    <mybatis-spring.version>4.0.0</mybatis-spring.version>
    <mybatis-plus.version>3.5.16</mybatis-plus.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <springdoc-openapi.version>3.2.1</springdoc-openapi.version>
    <spring-boot-admin.version>4.0.4</spring-boot-admin.version>
    <spring-security-jwt.version>1.1.1.RELEASE</spring-security-jwt.version>
    <oauth2-oidc-sdk.version>11.37</oauth2-oidc-sdk.version>
    <transmittable-thread-local.version>2.14.5</transmittable-thread-local.version>
    <excel-spring-boot-starter.version>3.4.3</excel-spring-boot-starter.version>
    <seancfoley.ipaddress.version>5.6.2</seancfoley.ipaddress.version>
    <bucket4j.version>8.18.0</bucket4j.version>
    <jspecify.version>1.0.0</jspecify.version>
    <jasypt.version>1.9.3</jasypt.version>

    <junit-pioneer.version>2.3.0</junit-pioneer.version>
  </properties>

  <modules>
    <module>fist-kit-infra</module>
    <module>fist-kit-app</module>
    <module>fist-kit-cloud</module>
    <module>fist-kit-build</module>
    <module>fist-kit-dependencies</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-fist-kit-v3</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>Fist Kit v4 cannot use com.power4j.fist3 dependencies.</message>
                  <excludes>
                    <exclude>com.power4j.fist3</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- help eclipse-plugin to get the right java-version -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
        </configuration>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>io.spring.javaformat</groupId>
          <artifactId>spring-javaformat-maven-plugin</artifactId>
          <version>${spring-javaformat.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${maven-source-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>flatten-maven-plugin</artifactId>
          <version>${flatten-maven-plugin.version}</version>
        </plugin>
        <!-- jacoco-maven-plugin -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>io.github.git-commit-id</groupId>
          <artifactId>git-commit-id-maven-plugin</artifactId>
          <version>${git-commit-id-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.cyclonedx</groupId>
          <artifactId>cyclonedx-maven-plugin</artifactId>
          <version>${cyclonedx-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>examples</id>
      <modules>
        <module>examples</module>
      </modules>
    </profile>

    <profile>
      <id>benchmarks</id>
      <modules>
        <module>benchmarks</module>
      </modules>
    </profile>

    <profile>
      <id>oss-snapshots</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <repositories>
        <repository>
          <id>central-snapshots</id>
          <url>https://central.sonatype.com/repository/maven-snapshots/</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
        </repository>
      </repositories>
    </profile>

    <profile>
      <id>oss-release</id>
      <build>
        <plugins>
          <!-- oss-release: maven-source-plugin already configured -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <encoding>UTF-8</encoding>
              <charset>UTF-8</charset>
              <docencoding>UTF-8</docencoding>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <additionalJOption>-Xdoclint:none</additionalJOption>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.10.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
